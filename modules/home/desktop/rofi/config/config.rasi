configuration {
  modi: "drun,run,filebrowser";
  font: "JetBrainsMono Nerd Font 12";
  show-icons: true;
  display-drun: " ";
  display-run: " ";
  display-filebrowser: " ";
  drun-display-format: "{name}";
}

@theme "~/.config/rofi/colors.rasi"

* {
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;
  background-color: transparent;
  text-color: @foreground;
}

window {
  width: 40%;
  border-radius: 12px;
  background-color: @background;
  border: 2px solid;
  border-color: @primary;
  padding: 10px;
}

mainbox {
  children: [inputbar, listview];
}

inputbar {
  children: [prompt, entry];
  background-color: @surface-container;
  border-radius: 8px;
  padding: 10px;
  margin: 0 0 10px 0;
}

prompt {
  padding: 0 10px 0 0;
  text-color: @primary;
}

entry {
  placeholder: "Search...";
  text-color: @foreground;
}

listview {
  lines: 8;
  columns: 1;
  fixed-height: true;
  spacing: 4px;
}

element {
  padding: 8px 10px;
  border-radius: 8px;
}

element selected {
  background-color: @primary;
  text-color: @background;
}

element-icon {
  size: 24px;
  margin: 0 10px 0 0;
}

element-text {
  vertical-align: 0.5;
  text-color: inherit;
}
