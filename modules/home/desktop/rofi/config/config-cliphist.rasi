configuration {
  modi: "dmenu";
  font: "JetBrainsMono Nerd Font 12";
  show-icons: false;
}

@theme "~/.config/rofi/colors.rasi"

* {
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;
  background-color: transparent;
  text-color: @foreground;
}

window {
  width: 40%;
  border-radius: 12px;
  background-color: @background;
  border: 2px solid;
  border-color: @primary;
  padding: 10px;
}

mainbox {
  children: [inputbar, listview];
}

inputbar {
  children: [prompt, entry];
  background-color: @surface-container;
  border-radius: 8px;
  padding: 10px;
  margin: 0 0 10px 0;
}

prompt {
  enabled: true;
  content: "󰅌 ";
  padding: 0 10px 0 0;
  text-color: @primary;
}

entry {
  placeholder: "Search Clipboard...";
  text-color: @foreground;
}

listview {
  lines: 12;
  columns: 1;
  fixed-height: true;
  spacing: 4px;
}

element {
  padding: 8px 10px;
  border-radius: 8px;
}

element selected {
  background-color: @primary;
  text-color: @background;
}

element-text {
  vertical-align: 0.5;
  text-color: inherit;
}
